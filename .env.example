# Copy to .env and adjust. Never commit .env.

# --- App ---------------------------------------------------------------
APP_NAME=DharaDrishti
ENVIRONMENT=development            # development | test | production (production hides /docs)
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
REQUEST_ID_HEADER=X-Request-ID
HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- PostgreSQL (used by docker compose to create the DB) ---------------
POSTGRES_USER=dharadrishti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dharadrishti
POSTGRES_PORT=5432                 # host port

# App database URL for running the backend on the HOST (outside Docker).
# Inside docker compose this is overridden to point at the "postgres" service.
DATABASE_URL=postgresql+asyncpg://dharadrishti:change-me@localhost:5432/dharadrishti
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis --------------------------------------------------------------
# Inside docker compose this is overridden to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379                    # host port

# --- Auth ---------------------------------------------------------------
# REQUIRED, >= 32 chars. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-output-of-secrets-token-urlsafe-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12                   # 12 is a sensible default; lower only in tests

# --- Ports --------------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=5173
