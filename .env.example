# Copy to .env and adjust. Never commit .env.

# --- App ---------------------------------------------------------------
APP_NAME=DharaDrishti
ENVIRONMENT=development            # development | test | production (production hides /docs)
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
REQUEST_ID_HEADER=X-Request-ID
HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- PostgreSQL (used by docker compose to create the DB) ---------------
POSTGRES_USER=dharadrishti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dharadrishti
POSTGRES_PORT=5432                 # host port

# App database URL for running the backend on the HOST (outside Docker).
# Inside docker compose this is overridden to point at the "postgres" service.
DATABASE_URL=postgresql+asyncpg://dharadrishti:change-me@localhost:5432/dharadrishti
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis --------------------------------------------------------------
# Inside docker compose this is overridden to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379                    # host port

# --- Auth ---------------------------------------------------------------
# REQUIRED, >= 32 chars. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-output-of-secrets-token-urlsafe-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12                   # 12 is a sensible default; lower only in tests

# --- Ingestion ------------------------------------------------------------
MAX_UPLOAD_MB=25
# Paths below are for running the backend on the host; the Docker image sets
# UPLOAD_DIR=/uploads, DATA_DIR=/data and HF_HOME=/models (volumes in docker-compose.yml).
UPLOAD_DIR=uploads
DATA_DIR=../data
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
INGESTION_JOB_TIMEOUT_SECONDS=1800

# --- Retrieval ------------------------------------------------------------
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16
RETRIEVAL_CANDIDATES=20            # top-N from each of keyword and vector search
RERANK_CANDIDATES=20               # fused candidates re-scored by the cross-encoder
RETRIEVAL_TOP_K=5                  # results kept after fusion / re-ranking
RRF_K=60
SECTION_LOOKUP_MAX_CHUNKS=3        # chunks per explicitly referenced section
MAX_SECTION_REFS=5
HNSW_EF_SEARCH=100

# --- LLM providers (free tiers / local). Model names come ONLY from here. ----
# Fallback order; providers without key/model are skipped.
LLM_PROVIDERS=groq,gemini,ollama
GROQ_API_KEY=                      # https://console.groq.com/keys
GROQ_MODEL=                        # e.g. a current Groq chat model id
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey
GEMINI_MODEL=                      # e.g. a current Gemini flash model id
OLLAMA_MODEL=                      # e.g. a model you've pulled with `ollama pull`
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3                 # per provider, with exponential backoff + jitter
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8

# --- Generation & guardrails ------------------------------------------------
ANSWER_MAX_TOKENS=800
ANSWER_TEMPERATURE=0.1
CONTEXT_MAX_TOKENS=3000
QUERY_REWRITE_ENABLED=true
TOPIC_CLASSIFIER_ENABLED=true
FAITHFULNESS_CHECK_ENABLED=true
QUERY_MIN_CHARS=3
QUERY_MAX_CHARS=1000
INJECTION_BLOCK_SCORE=1.0
RERANK_REFUSAL_THRESHOLD=0.2       # tune with the evaluation harness

# --- Evaluation ---------------------------------------------------------------
# EVAL_DATASET_PATH=               # default: <DATA_DIR>/eval/golden.jsonl
EVAL_RETRIEVAL_K=10
EVAL_JOB_TIMEOUT_SECONDS=14400

# --- Cache, limits, CORS -----------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
RATE_LIMIT_USER_PER_MINUTE=20
RATE_LIMIT_IP_PER_MINUTE=40
AUTH_RATE_LIMIT_PER_MINUTE=10       # login/register/refresh attempts per IP
DAILY_TOKEN_BUDGET=100000
CORS_ORIGINS=http://localhost:5173

# --- Ports --------------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=5173
